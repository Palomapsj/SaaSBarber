# Copy to .env.local and adjust.

# Shows the "Sou Cliente / Barbeiro / Admin" selector from the prototype. Development only.
NEXT_PUBLIC_DEV_PROFILE_SELECTOR=true

# Signs the panel session cookie (at least 32 random characters). Never commit the real value.
# PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
# Bash: openssl rand -base64 48
SESSION_SECRET=
